# Keep only the main PF4SL/PFSL source and its preparation/runtime dependencies.
# Local files are never deleted by these rules. New source must be added to the
# allowlist below; experiments and generated artifacts stay local by default.
/*
!/.gitignore
!/README.md
!/environment.sh
!/train.py
!/test.py

# Vendored training framework, including attribution and configuration.
!/coach_pl/
!/coach_pl/**

# Main package. Legacy registration imports are retained so importing pfsl and
# running the original train.py / script/pf.py entry points still work.
!/pfsl/
/pfsl/*
!/pfsl/__init__.py
!/pfsl/omics_scaling.py
!/pfsl/ppi.py
!/pfsl/configuration/
/pfsl/configuration/*
!/pfsl/configuration/prosl.yaml
!/pfsl/dataset/
/pfsl/dataset/*
!/pfsl/dataset/__init__.py
!/pfsl/dataset/neg_sampler.py
!/pfsl/dataset/prosl.py
!/pfsl/dataset/sl.py
!/pfsl/dataset/sl_raw.py
!/pfsl/model/
/pfsl/model/*
!/pfsl/model/__init__.py
!/pfsl/model/attention.py
!/pfsl/model/attn_wrap.py
!/pfsl/model/calibrator.py
!/pfsl/model/cnn.py
!/pfsl/model/linear.py
!/pfsl/model/lora.py
!/pfsl/model/mlp.py
!/pfsl/model/omics.py
!/pfsl/model/pooling.py
!/pfsl/model/ppi.py
!/pfsl/model/prosl.py
!/pfsl/model/protfunc.py
!/pfsl/model/token_model.py
!/pfsl/module/
/pfsl/module/*
!/pfsl/module/__init__.py
!/pfsl/module/cls_module.py
!/pfsl/module/prosl.py
!/pfsl/module/tent.py
!/pfsl/module/uncertainty.py
!/pfsl/utils/
/pfsl/utils/*
!/pfsl/utils/metric.py

# Current paper model: no_graph_concat in fusion.py. The other four files are
# direct runtime imports of train_pfsl_next.py and its shared feature loader.
!/pfsl/next/
/pfsl/next/*
!/pfsl/next/__init__.py
!/pfsl/next/data.py
!/pfsl/next/model.py
!/pfsl/next/fusion.py
!/pfsl/next/da.py

# Main launchers and shared feature-bank preparation. Despite its historical
# name, slkb_baseline_common.py supplies split loading to the main runner.
!/script/
/script/*
!/script/pf.py
!/script/train_pfsl_next.py
!/script/prepare_ppi.py
!/script/prepare_next_bank.py
!/script/slkb_baseline_common.py

# Main SLKB splits and UniProt text preparation; baseline adapters and result
# collectors in these directories are deliberately excluded.
!/data_preprocess/
/data_preprocess/*
!/data_preprocess/preprocess.ipynb
!/data_preprocess/ccle_filter.ipynb
!/data_preprocess/utils.py
!/pfsl_process/
/pfsl_process/*
!/pfsl_process/pf.ipynb
!/pfsl_process/text_pre.py
!/pfsl_process/utils.py

# Regression checks for training-gene normalization and structural ablations.
!/tests/
/tests/*
!/tests/__init__.py
!/tests/test_strict_protocol.py

# The root allowlist excludes, among others:
# data/, sc_data/, output/, external_data/, *metric_count*/, pf4sl_*/,
# paper*/, research/, docs/, esmc_sae/, pfsl_graph/, pfsl/uq/,
# pfsl_process/sae/, and baseline/SAE/LLM/experimental launch scripts.

# Safety rules also apply inside allowed directories.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.env
.env.*
!.env.example
.venv/
venv/
env/
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json
*.log
logs/
runs/
lightning_logs/
wandb/
tb_logs/
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.msgpack
*.pkl
*.pickle
*.npy
*.npz
*.h5
*.hdf5
*.h5ad
*.arrow
*.feather
*.parquet
*.csv
*.tsv
*.jsonl
*.jsonl.gz
*.csv.gz
*.tsv.gz
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
.DS_Store
Thumbs.db
*.swp
*.swo
*~
